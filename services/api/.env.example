# Backend environment.
# Copy to `.env` for local development.

# Required
DATABASE_URL=postgresql+psycopg://fintech:fintech_dev_only@localhost:5432/fintech

# 32+ byte random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-secret-min-32-bytes

# Comma-separated list of origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Optional
APP_ENV=development
LOG_LEVEL=INFO
SESSION_TTL_HOURS=720        # 30 days
COOKIE_SECURE=false          # set true in production
COOKIE_NAME=bb_session
RESET_TOKEN_TTL_HOURS=1
