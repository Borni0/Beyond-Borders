# Root-level shared environment placeholders.
# Copy to `.env` and fill in for local development.
# Backend-specific vars live in services/api/.env.example
# Frontend-specific vars live in apps/web/.env.example

# Postgres (used by docker-compose.yml and services/api)
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_dev_only
POSTGRES_DB=fintech
POSTGRES_PORT=5432

# Backend (also see services/api/.env.example)
DATABASE_URL=postgresql+psycopg://fintech:fintech_dev_only@localhost:5432/fintech
SECRET_KEY=replace-with-a-secure-random-secret-min-32-bytes
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (also see apps/web/.env.example)
NEXT_PUBLIC_APP_NAME=Beyond Borders
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1