{
  "name": "beyond-borders",
  "private": true,
  "version": "0.1.0",
  "description": "Beyond Borders monorepo (Phase 1 foundation).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test:web": "npm test -w apps/web",
    "e2e": "npm run e2e -w apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}